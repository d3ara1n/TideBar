---
import { ArrowDown, Bell, Check, ChevronRight, CodeXml, Folder, LayoutList, Waves, X } from "@lucide/astro";
import TideBarNav from "./TideBarNav.astro";

interface Props {
  lang?: "en" | "zh";
}

const { lang = "en" } = Astro.props;
const en = lang === "en";

const titles = en
  ? { features: "Features", privacy: "Privacy", download: "Download", source: "Source" }
  : { features: "功能", privacy: "隐私", download: "下载", source: "源码" };
---
<main class="desktop" id="main-content">
  <div class="desktop-wallpaper" aria-hidden="true"></div>

  <section class="desktop-hero" id="home" aria-labelledby="hero-title">
    <p class="eyebrow">{en ? "TideBar · Free and open source" : "汐 TideBar · 免费开源"}</p>
    <h1 id="hero-title">
      {en
        ? <>A macOS taskbar <span class="headline-dim">that collapses to a line.</span></>
        : <>macOS 窗口任务栏，<span class="headline-dim">闲置时收成一条线。</span></>}
    </h1>
    <p class="lede">
      {en
        ? "Move the pointer near the bottom of your screen to launch apps, switch windows, or open pinned files and folders. Move away and the bar collapses."
        : "鼠标靠近屏幕底部时展开，可启动应用、切换窗口，以及打开固定的文件和文件夹。鼠标移开后自动收起。"}
    </p>
    <div class="hero-actions">
      <a class="button button-primary" href="#download" data-section-link="download">
        <ArrowDown strokeWidth={2.2} aria-hidden="true" />
        {en ? "Download for macOS" : "下载 macOS 版"}
      </a>
      <a class="text-link" href="#features" data-section-link="features">
        {en ? "View features" : "查看功能"}
        <ChevronRight strokeWidth={2.2} aria-hidden="true" />
      </a>
    </div>
    <p class="hero-meta">{en ? "macOS 14+ · MIT License" : "macOS 14+ · MIT 许可证"}</p>
  </section>

  <section class="window" id="features" data-window="features" aria-labelledby="features-title">
    <div class="window-titlebar">
      <button class="window-close" type="button" data-close aria-label={en ? "Close window" : "关闭窗口"}>
        <X strokeWidth={2.6} aria-hidden="true" />
      </button>
      <span class="window-dot yellow" aria-hidden="true"></span>
      <span class="window-dot green" aria-hidden="true"></span>
      <span class="window-title">{titles.features}</span>
    </div>
    <div class="window-body">
      <p class="eyebrow">{titles.features}</p>
      <h2 id="features-title">
        {en
          ? <>Manage apps, windows, <span class="headline-dim">files, and folders.</span></>
          : <>启动应用、切换窗口，<span class="headline-dim">打开文件和文件夹。</span></>}
      </h2>
      <div class="feature-grid">
        <article class="feature-card">
          <span class="feature-chip"><Waves strokeWidth={1.8} aria-hidden="true" /></span>
          <h3>{en ? "Expand on hover" : "靠近展开"}</h3>
          <p>{en
            ? "The bar collapses to a thin line when idle. Move the pointer near it to expand. Appearance and animation settings are adjustable."
            : "闲置时收起为细线，鼠标靠近时展开。外观和动画可在设置中调整。"}</p>
        </article>
        <article class="feature-card">
          <span class="feature-chip"><LayoutList strokeWidth={1.8} aria-hidden="true" /></span>
          <h3>{en ? "Switch windows" : "切换窗口"}</h3>
          <p>{en
            ? "Hold or Option-click an app to select a window by title, including minimized windows. Filled dots mean non-minimized; hollow dots mean minimized."
            : "长按或 Option-click 应用，按标题选择窗口，最小化窗口也可恢复。图标下实心点表示未最小化，空心点表示已最小化。"}</p>
        </article>
        <article class="feature-card">
          <span class="feature-chip"><Folder strokeWidth={1.8} aria-hidden="true" /></span>
          <h3>{en ? "Pin apps and files" : "固定应用与文件"}</h3>
          <p>{en
            ? "Pin apps, files, and folders, then drag to reorder them. Hold a folder to list recently modified items, or create an app collection for grouped launch shortcuts."
            : "固定应用、文件和文件夹，拖拽调整顺序。长按文件夹查看最近修改的项目，也可创建应用收藏夹来分组保存启动入口。"}</p>
        </article>
        <article class="feature-card">
          <span class="feature-chip"><Bell strokeWidth={1.8} aria-hidden="true" /></span>
          <h3>{en ? "Notification badges" : "通知角标"}</h3>
          <p>{en
            ? "App badges are read from the system Dock. New badges trigger a line animation; expanding the bar stops it without marking messages as read."
            : "从系统 Dock 读取应用角标。有新角标时细线播放提醒动画，展开图标栏后停止，不会把原应用的消息标为已读。"}</p>
        </article>
      </div>
      <p class="window-note">{en
        ? "In fullscreen apps the line opens on a click by default; hover-to-open and fully hidden modes are in Settings."
        : "全屏应用下默认点击汐线展开；悬停展开与完全隐藏可在设置中选择。"}</p>
    </div>
  </section>

  <section class="window" id="privacy" data-window="privacy" aria-labelledby="privacy-title">
    <div class="window-titlebar">
      <button class="window-close" type="button" data-close aria-label={en ? "Close window" : "关闭窗口"}>
        <X strokeWidth={2.6} aria-hidden="true" />
      </button>
      <span class="window-dot yellow" aria-hidden="true"></span>
      <span class="window-dot green" aria-hidden="true"></span>
      <span class="window-title">{titles.privacy}</span>
    </div>
    <div class="window-body">
      <p class="eyebrow">{en ? "Permissions and privacy" : "权限与隐私"}</p>
      <h2 id="privacy-title">
        {en
          ? <>Window management <span class="headline-dim">uses Accessibility access.</span></>
          : <>通过辅助功能权限<span class="headline-dim">管理窗口。</span></>}
      </h2>
      <p class="lede">
        {en
          ? "Accessibility access lets TideBar read window titles and states, focus and restore windows, detect fullscreen apps, and read Dock badges. File access follows macOS access controls."
          : "辅助功能权限用于读取窗口标题与状态、聚焦和恢复窗口、识别全屏应用，以及读取 Dock 角标。文件访问遵循 macOS 的访问控制。"}
      </p>
      <div class="privacy-list">
        <span class="privacy-pill"><Check strokeWidth={2.4} aria-hidden="true" />{en ? "No Screen Recording permission" : "不申请屏幕录制"}</span>
        <span class="privacy-pill"><Check strokeWidth={2.4} aria-hidden="true" />{en ? "No window thumbnails" : "不显示窗口缩略图"}</span>
        <span class="privacy-pill"><Check strokeWidth={2.4} aria-hidden="true" />{en ? "No usage analytics or account" : "无使用情况分析、无账号"}</span>
      </div>
      <p class="window-note">{en
        ? "Packaged builds use Sparkle to check GitHub Releases for updates. Turn off automatic checks in Settings → About."
        : "打包版通过 Sparkle 从 GitHub Releases 检查更新，可在「设置 → 关于」中关闭自动检查。"}</p>
    </div>
  </section>

  <section class="window" id="download" data-window="download" aria-labelledby="download-title">
    <div class="window-titlebar">
      <button class="window-close" type="button" data-close aria-label={en ? "Close window" : "关闭窗口"}>
        <X strokeWidth={2.6} aria-hidden="true" />
      </button>
      <span class="window-dot yellow" aria-hidden="true"></span>
      <span class="window-dot green" aria-hidden="true"></span>
      <span class="window-title">{titles.download}</span>
    </div>
    <div class="window-body">
      <p class="eyebrow">{en ? "macOS 14 or later" : "macOS 14 或更高版本"}</p>
      <h2 id="download-title">
        {en
          ? <>Install <span class="headline-dim">TideBar.</span></>
          : <>安装 <span class="headline-dim">TideBar。</span></>}
      </h2>
      <div class="window-actions">
        <a class="button button-primary" href="https://github.com/d3ara1n/TideBar/releases">
          <ArrowDown strokeWidth={2.2} aria-hidden="true" />
          {en ? "Download latest release" : "下载最新版本"}
        </a>
        <a class="button button-glass" href="https://github.com/d3ara1n/TideBar">
          <CodeXml strokeWidth={1.8} aria-hidden="true" />
          {en ? "View on GitHub" : "在 GitHub 查看"}
        </a>
      </div>
      <p class="window-note">{en
        ? "Extract the release ZIP and move TideBar.app to Applications. Builds are not notarized by Apple; if macOS blocks the app, use Open Anyway in System Settings → Privacy & Security after trying to launch it."
        : "解压发布 ZIP，将 TideBar.app 移到「应用程序」。构建未经 Apple 公证；若 macOS 阻止打开，请在尝试启动后，到「系统设置 → 隐私与安全性」选择「仍要打开」。"}</p>
      <p class="window-note">{en
        ? "The setup guide asks for Accessibility access and Dock takeover. Takeover saves and changes your Dock settings, then restarts the Dock to hide it. The taskbar appears while takeover is enabled; normal quit restores the saved settings."
        : "首次启动引导包含辅助功能授权和 Dock 接管。接管会保存并修改 Dock 设置，重启 Dock 以隐藏它。启用接管后才显示任务栏，正常退出时恢复保存的设置。"}</p>
      <a class="text-link" href={en ? "https://github.com/d3ara1n/TideBar#install" : "https://github.com/d3ara1n/TideBar/blob/main/README.zh-CN.md#安装"}>
        {en ? "Setup, recovery, and usage instructions" : "安装、恢复与使用说明"}
        <ChevronRight strokeWidth={2.2} aria-hidden="true" />
      </a>
    </div>
  </section>

  <section class="window" id="source" data-window="source" aria-labelledby="source-title">
    <div class="window-titlebar">
      <button class="window-close" type="button" data-close aria-label={en ? "Close window" : "关闭窗口"}>
        <X strokeWidth={2.6} aria-hidden="true" />
      </button>
      <span class="window-dot yellow" aria-hidden="true"></span>
      <span class="window-dot green" aria-hidden="true"></span>
      <span class="window-title">{titles.source}</span>
    </div>
    <div class="window-body">
      <p class="eyebrow">{en ? "Source and feedback" : "源码与反馈"}</p>
      <h2 id="source-title">
        {en
          ? <>Build from source <span class="headline-dim">or report an issue.</span></>
          : <>从源码构建，<span class="headline-dim">或反馈问题。</span></>}
      </h2>
      <p class="lede">
        {en
          ? "TideBar is written in Swift and released under the MIT License. Build it on macOS with Swift 6.2 or later. For bug reports, include your macOS version, TideBar version, and steps to reproduce."
          : "TideBar 使用 Swift 编写，采用 MIT 许可证。可在 macOS 上通过 Swift 6.2 或更高版本构建。报告问题时，请附上 macOS 版本、TideBar 版本和复现步骤。"}
      </p>
      <div class="window-actions">
        <a class="button button-glass" href="https://github.com/d3ara1n/TideBar">
          <CodeXml strokeWidth={1.8} aria-hidden="true" />
          d3ara1n/TideBar
        </a>
        <a class="text-link" style="align-self:center" href="https://github.com/d3ara1n/TideBar/issues">
          {en ? "Report an issue" : "问题反馈"}
          <ChevronRight strokeWidth={2.2} aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <footer class="desktop-corner">
    <p>{en ? "TideBar · MIT License" : "汐 TideBar · MIT License"}</p>
    <p class="corner-hint">{en ? "Move the pointer near the line below to open this site's navigation." : "鼠标靠近下方细线可展开网站导航。"}</p>
  </footer>
</main>

<TideBarNav lang={lang} />
