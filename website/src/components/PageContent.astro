---
import { ArrowDown, Bell, Check, ChevronRight, CircleDot, CodeXml, LayoutList, Waves, X } from "@lucide/astro";
import TideBarNav from "./TideBarNav.astro";

interface Props {
  lang?: "en" | "zh";
}

const { lang = "en" } = Astro.props;
const en = lang === "en";

const titles = en
  ? { features: "Features", demo: "Demo", privacy: "Privacy", download: "Download", source: "Source" }
  : { features: "特色", demo: "演示", privacy: "隐私", download: "下载", source: "源码" };
---
<main class="desktop" id="main-content">
  <div class="desktop-wallpaper" aria-hidden="true"></div>

  <section class="desktop-hero" id="home" aria-labelledby="hero-title">
    <p class="eyebrow">{en ? "A zero-footprint window taskbar for macOS" : "macOS 不占屏幕的窗口任务栏"}</p>
    <h1 id="hero-title">
      {en
        ? <>A hairline at rest, <span class="headline-dim">every window at hand.</span></>
        : <>平时是一条线，<span class="headline-dim">需要时每个窗口触手可及。</span></>}
    </h1>
    <p class="lede">
      {en
        ? "TideBar tucks into the bottom edge as a hairline until you need it — then apps and every window are one move away. Turn on takeover and the Dock steps aside, giving a small MacBook a full row back."
        : "汐平时收成屏幕底边的一条细线，需要时展开为图标栏——应用与每个窗口都一触即达。开启接管，系统 Dock 隐去，小屏 MacBook 多出一整行空间。"}
    </p>
    <div class="hero-actions">
      <a class="button button-primary" href="#download" data-section-link="download">
        <ArrowDown strokeWidth={2.2} aria-hidden="true" />
        {en ? "Download for macOS" : "下载 macOS 版"}
      </a>
      <a class="text-link" href="#features" data-section-link="features">
        {en ? "Explore the tide" : "了解潮汐交互"}
        <ChevronRight strokeWidth={2.2} aria-hidden="true" />
      </a>
    </div>
    <p class="hero-meta">{en ? "macOS 14+ · Accessibility only · Open source" : "macOS 14+ · 仅需辅助功能 · 开源"}</p>
  </section>

  <section class="window" id="features" data-window="features" aria-labelledby="features-title">
    <div class="window-titlebar">
      <button class="window-close" type="button" data-close aria-label={en ? "Close window" : "关闭窗口"}>
        <X strokeWidth={2.6} aria-hidden="true" />
      </button>
      <span class="window-dot yellow" aria-hidden="true"></span>
      <span class="window-dot green" aria-hidden="true"></span>
      <span class="window-title">{titles.features}</span>
    </div>
    <div class="window-body">
      <p class="eyebrow">{en ? "The tide in four movements" : "四种潮汐状态"}</p>
      <h2 id="features-title">
        {en
          ? <>Quiet by default. <span class="headline-dim">Ready when called.</span></>
          : <>平时安静，<span class="headline-dim">唤之即来。</span></>}
      </h2>
      <div class="feature-grid">
        <article class="feature-card">
          <span class="feature-chip"><Waves strokeWidth={1.8} aria-hidden="true" /></span>
          <h3>{en ? "Tide Line" : "汐线"}</h3>
          <p>{en
            ? "A 2–3pt hairline hugs the bottom edge until your cursor calls up the icon bar."
            : "2–3pt 细线贴着屏幕底边，光标靠近即展开为图标栏。"}</p>
        </article>
        <article class="feature-card">
          <span class="feature-chip"><CircleDot strokeWidth={1.8} aria-hidden="true" /></span>
          <h3>{en ? "Dots" : "点点"}</h3>
          <p>{en
            ? "Window state is visible at a glance: active windows filled, minimized windows hollow."
            : "窗口状态一眼可见：活跃窗口实心，最小化窗口空心。"}</p>
        </article>
        <article class="feature-card">
          <span class="feature-chip"><LayoutList strokeWidth={1.8} aria-hidden="true" /></span>
          <h3>{en ? "Surge" : "潮涌"}</h3>
          <p>{en
            ? "Click and hold an app to reach any window — minimized ones included, one click to restore."
            : "按住应用即可直达任意窗口——最小化的也在列表里，点击即还原。"}</p>
        </article>
        <article class="feature-card">
          <span class="feature-chip"><Bell strokeWidth={1.8} aria-hidden="true" /></span>
          <h3>{en ? "Ripple" : "涟漪"}</h3>
          <p>{en
            ? "Unread badges keep the line gently present, never loud. Opening the bar settles it."
            : "未读角标让细线保持轻微在场，不抢夺注意力；展开即确认。"}</p>
        </article>
      </div>
      <p class="window-note">{en
        ? "In fullscreen apps the line opens on a click by default; hover-to-open and fully hidden modes are in Settings."
        : "全屏应用下默认点击汐线展开；悬停展开与完全隐藏可在设置中选择。"}</p>
    </div>
  </section>

  <section class="window" id="demo" data-window="demo" aria-label={titles.demo}>
    <div class="window-titlebar">
      <button class="window-close" type="button" data-close aria-label={en ? "Close window" : "关闭窗口"}>
        <X strokeWidth={2.6} aria-hidden="true" />
      </button>
      <span class="window-dot yellow" aria-hidden="true"></span>
      <span class="window-dot green" aria-hidden="true"></span>
      <span class="window-title">{titles.demo}</span>
    </div>
    <div class="window-body">
      <img
        class="demo-shot"
        src="/demo.webp"
        width="1600"
        height="1000"
        alt={en
          ? "The hairline resting at the bottom edge, the icon bar risen from it, and the Surge window list of a single app."
          : "屏幕底边的细线、由它展开的图标栏，以及某个应用的潮涌窗口列表。"}
      />
    </div>
  </section>

  <section class="window" id="privacy" data-window="privacy" aria-labelledby="privacy-title">
    <div class="window-titlebar">
      <button class="window-close" type="button" data-close aria-label={en ? "Close window" : "关闭窗口"}>
        <X strokeWidth={2.6} aria-hidden="true" />
      </button>
      <span class="window-dot yellow" aria-hidden="true"></span>
      <span class="window-dot green" aria-hidden="true"></span>
      <span class="window-title">{titles.privacy}</span>
    </div>
    <div class="window-body">
      <p class="eyebrow">{en ? "Designed with restraint" : "克制的设计"}</p>
      <h2 id="privacy-title">
        {en
          ? <>One permission. <span class="headline-dim">No screen recording. No telemetry.</span></>
          : <>一项权限。<span class="headline-dim">不申请屏幕录制。无遥测。</span></>}
      </h2>
      <p class="lede">
        {en
          ? "TideBar uses Accessibility only to list and restore windows and detect fullscreen state. It shows no window thumbnails, asks for no Screen Recording permission, and collects nothing about you."
          : "汐仅使用辅助功能来列出、还原窗口并识别全屏状态。不显示窗口缩略图，不申请屏幕录制权限，也不收集你的任何信息。"}
      </p>
      <div class="privacy-list">
        <span class="privacy-pill"><Check strokeWidth={2.4} aria-hidden="true" />{en ? "Accessibility only" : "仅需辅助功能"}</span>
        <span class="privacy-pill"><Check strokeWidth={2.4} aria-hidden="true" />{en ? "No window thumbnails" : "不显示窗口缩略图"}</span>
        <span class="privacy-pill"><Check strokeWidth={2.4} aria-hidden="true" />{en ? "No tracking or account" : "无追踪、无账号"}</span>
      </div>
    </div>
  </section>

  <section class="window" id="download" data-window="download" aria-labelledby="download-title">
    <div class="window-titlebar">
      <button class="window-close" type="button" data-close aria-label={en ? "Close window" : "关闭窗口"}>
        <X strokeWidth={2.6} aria-hidden="true" />
      </button>
      <span class="window-dot yellow" aria-hidden="true"></span>
      <span class="window-dot green" aria-hidden="true"></span>
      <span class="window-title">{titles.download}</span>
    </div>
    <div class="window-body">
      <p class="eyebrow">{en ? "Give the bottom edge back" : "把屏幕底边还给你"}</p>
      <h2 id="download-title">
        {en
          ? <>A calmer way to reach <span class="headline-dim">every window.</span></>
          : <>更安静地抵达<span class="headline-dim">每个窗口。</span></>}
      </h2>
      <div class="window-actions">
        <a class="button button-primary" href="https://github.com/d3ara1n/TideBar/releases">
          <ArrowDown strokeWidth={2.2} aria-hidden="true" />
          {en ? "Download latest release" : "下载最新版本"}
        </a>
        <a class="button button-glass" href="https://github.com/d3ara1n/TideBar">
          <CodeXml strokeWidth={1.8} aria-hidden="true" />
          {en ? "View on GitHub" : "在 GitHub 查看"}
        </a>
      </div>
      <p class="window-note">{en ? "Free and open source under the MIT License." : "MIT 许可证下免费开源。"}</p>
    </div>
  </section>

  <section class="window" id="source" data-window="source" aria-labelledby="source-title">
    <div class="window-titlebar">
      <button class="window-close" type="button" data-close aria-label={en ? "Close window" : "关闭窗口"}>
        <X strokeWidth={2.6} aria-hidden="true" />
      </button>
      <span class="window-dot yellow" aria-hidden="true"></span>
      <span class="window-dot green" aria-hidden="true"></span>
      <span class="window-title">{titles.source}</span>
    </div>
    <div class="window-body">
      <p class="eyebrow">{en ? "Built in the open" : "开放构建"}</p>
      <h2 id="source-title">
        {en
          ? <>Follow the work <span class="headline-dim">behind the tide.</span></>
          : <>了解潮汐<span class="headline-dim">背后的构建过程。</span></>}
      </h2>
      <p class="lede">
        {en
          ? "Read the decisions, inspect the source, or help shape what TideBar becomes next."
          : "阅读架构决策、查看源码，或一起塑造汐的下一步。"}
      </p>
      <div class="window-actions">
        <a class="button button-glass" href="https://github.com/d3ara1n/TideBar">
          <CodeXml strokeWidth={1.8} aria-hidden="true" />
          d3ara1n/TideBar
        </a>
        <a class="text-link" style="align-self:center" href="https://github.com/d3ara1n/TideBar/releases">
          {en ? "Release notes" : "版本记录"}
          <ChevronRight strokeWidth={2.2} aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <footer class="desktop-corner">
    <p>{en ? "TideBar · MIT License" : "汐 TideBar · MIT License"}</p>
    <p class="corner-hint">{en ? "This page is the demo — hover the line below." : "这个页面本身就是演示——悬停下方细线。"}</p>
  </footer>
</main>

<TideBarNav lang={lang} />
