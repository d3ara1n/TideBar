---
import { ArrowDown, CodeXml, House, MonitorPlay, ShieldCheck, Sparkles } from "@lucide/astro";

interface Props {
  lang?: "en" | "zh";
}

const { lang = "en" } = Astro.props;
const labels = lang === "en"
  ? { home: "Home", demo: "Demo", features: "Features", privacy: "Privacy", download: "Download", source: "Source" }
  : { home: "首页", demo: "演示", features: "功能", privacy: "隐私", download: "下载", source: "源码" };
---
<nav class="tide-nav" aria-label={lang === "en" ? "Main navigation" : "主导航"}>
  <div class="tide-nav-hit">
    <div class="tide-nav-line" aria-hidden="true"></div>
    <div class="tide-nav-bar">
      <a class="tide-nav-item" style="--i:0" href="#home" data-section="home">
        <span class="nav-icon tile-home"><House strokeWidth={1.9} aria-hidden="true" /></span>
        <span class="nav-name">{labels.home}</span>
      </a>
      <a class="tide-nav-item" style="--i:1" href="#demo" data-section="demo">
        <span class="nav-icon tile-demo"><MonitorPlay strokeWidth={1.9} aria-hidden="true" /></span>
        <span class="nav-name">{labels.demo}</span>
      </a>
      <a class="tide-nav-item" style="--i:2" href="#features" data-section="features">
        <span class="nav-icon tile-features"><Sparkles strokeWidth={1.9} aria-hidden="true" /></span>
        <span class="nav-name">{labels.features}</span>
      </a>
      <a class="tide-nav-item" style="--i:3" href="#privacy" data-section="privacy">
        <span class="nav-icon tile-privacy"><ShieldCheck strokeWidth={1.9} aria-hidden="true" /></span>
        <span class="nav-name">{labels.privacy}</span>
      </a>
      <a class="tide-nav-item" style="--i:4" href="#download" data-section="download">
        <span class="nav-icon tile-download"><ArrowDown strokeWidth={1.9} aria-hidden="true" /></span>
        <span class="nav-name">{labels.download}</span>
      </a>
      <a class="tide-nav-item" style="--i:5" href="#source" data-section="source">
        <span class="nav-icon tile-source"><CodeXml strokeWidth={1.9} aria-hidden="true" /></span>
        <span class="nav-name">{labels.source}</span>
      </a>
    </div>
  </div>
</nav>

<script>
  const desktopMode = matchMedia("(min-width: 821px)");
  const nav = document.querySelector<HTMLElement>(".tide-nav");
  const desktop = document.querySelector<HTMLElement>(".desktop");
  const items = [...document.querySelectorAll<HTMLAnchorElement>(".tide-nav-item[data-section]")];
  const windows = [...document.querySelectorAll<HTMLElement>(".window[data-window]")];
  const appName = document.getElementById("menubar-app-name");
  const demoVideo = document.querySelector<HTMLVideoElement>("video.demo-video");
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
  const isZh = document.documentElement.lang === "zh-CN";
  const appNames: Record<string, string> = isZh
    ? { home: "汐", demo: "演示", features: "功能", privacy: "隐私", download: "下载", source: "源码" }
    : { home: "TideBar", demo: "Demo", features: "Features", privacy: "Privacy", download: "Download", source: "Source" };

  // 视频按需加载：preload="none"，仅在演示可见时播放；减少动态效果时交给用户手动控制
  if (demoVideo && reducedMotion.matches) {
    demoVideo.controls = true;
  }
  const playDemo = () => {
    if (!demoVideo || reducedMotion.matches) return;
    demoVideo.play().catch(() => {});
  };

  let current = "home";
  let opener: HTMLElement | null = null;

  // 移动端堆叠布局：视频滚动进入视口才加载播放，离开即暂停
  if (demoVideo && "IntersectionObserver" in window) {
    new IntersectionObserver(([entry]) => {
      if (desktopMode.matches) return;
      if (entry.isIntersecting) playDemo();
      else demoVideo.pause();
    }, { threshold: 0.25 }).observe(demoVideo);
  }

  // 桌面模式下非激活窗口 inert（屏蔽焦点与读屏）；堆叠布局全部可达
  function syncInert() {
    for (const win of windows) {
      win.inert = desktopMode.matches && win.dataset.window !== current;
    }
  }
  desktopMode.addEventListener("change", () => {
    syncInert();
    if (!desktopMode.matches) demoVideo?.pause();
    else if (current === "demo") playDemo();
  });

  function activate(id: string, syncHash = true, moveFocus = false) {
    const previous = current;
    current = id;
    const windowOpen = id !== "home";
    desktop?.classList.toggle("has-window", windowOpen);
    for (const win of windows) {
      const active = win.dataset.window === id;
      win.classList.toggle("is-active", active);
    }
    syncInert();
    for (const item of items) {
      item.toggleAttribute("aria-current", item.dataset.section === id);
    }
    if (demoVideo && desktopMode.matches) {
      // 演示窗口不可见时暂停视频，回到窗口再续播
      if (id === "demo") playDemo();
      else demoVideo.pause();
    }
    if (moveFocus && desktopMode.matches) {
      // 键盘操作：打开窗口时焦点移入，关闭时回到打开它的元素
      if (windowOpen) {
        windows.find((w) => w.dataset.window === id)?.querySelector<HTMLElement>("[data-close]")?.focus();
      } else if (previous !== "home") {
        opener?.focus();
        opener = null;
      }
    }
    if (appName) {
      appName.textContent = windowOpen ? `${appNames.home} — ${appNames[id]}` : appNames.home;
    }
    if (syncHash && desktopMode.matches) {
      const url = windowOpen ? `#${id}` : location.pathname;
      history.replaceState(null, "", url);
    }
  }

  addEventListener("keydown", (event) => {
    if (event.key === "Escape" && current !== "home") activate("home", true, true);
  });

  // 触摸设备：点按汐线展开（桌面靠鼠标热区 hover，不用点击锁定）
  const touchMode = matchMedia("(hover: none)");
  nav?.querySelector(".tide-nav-line")?.addEventListener("click", () => {
    if (touchMode.matches) nav.classList.toggle("is-open");
  });
  nav?.addEventListener("focusin", () => nav.classList.add("is-open"));
  nav?.addEventListener("focusout", (event) => {
    if (!nav.contains(event.relatedTarget as Node | null)) nav.classList.remove("is-open");
  });

  // 桌面模式：导航/CTA/红灯点击 = 切换窗口（拦截锚点滚动）
  document.addEventListener("click", (event) => {
    const anchor = (event.target as Element).closest<HTMLAnchorElement>("a[href^='#']");
    const closer = (event.target as Element).closest("[data-close]");
    if (closer) {
      activate("home", true, event.detail === 0);
      return;
    }
    if (!anchor) return;
    const id = anchor.dataset.section ?? anchor.getAttribute("href")?.slice(1) ?? "";
    if (!["home", "demo", "features", "privacy", "download", "source"].includes(id)) return;
    if (!desktopMode.matches) return; // 移动端保持锚点滚动
    event.preventDefault();
    const keyboard = event.detail === 0;
    if (keyboard && id !== "home") opener = anchor;
    activate(id, true, keyboard);
    // 指针点击后交还焦点，避免 :focus-within 把栏锁定在展开态
    if (event.detail > 0) (document.activeElement as HTMLElement | null)?.blur();
  });

  // 点击桌面空白处回到桌面
  desktop?.addEventListener("click", (event) => {
    if (!desktopMode.matches) return;
    if ((event.target as Element).closest(".window, .tide-nav, a, button")) return;
    if (current !== "home") activate("home");
  });

  // hash 直达
  const initial = location.hash.slice(1);
  if (["demo", "features", "privacy", "download", "source"].includes(initial)) {
    activate(initial, false);
  } else {
    activate("home", false);
  }
</script>
