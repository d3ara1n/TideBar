---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang?: "en" | "zh";
}

const { title, description, lang = "en" } = Astro.props;
const alternatePath = lang === "en" ? "/zh/" : "/";
const alternateLabel = lang === "en" ? "简体中文" : "English";
---
<!doctype html>
<html lang={lang === "en" ? "en" : "zh-CN"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101319" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="alternate" hreflang={lang === "en" ? "zh-CN" : "en"} href={`${Astro.site}${alternatePath}`} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{lang === "en" ? "Skip to content" : "跳到内容"}</a>
    <header class="site-header">
      <a class="wordmark" href={lang === "en" ? "/" : "/zh/"} aria-label="TideBar home">
        <span class="wordmark-mark" aria-hidden="true">~</span>
        <span>TideBar</span>
      </a>
      <a class="language-link" href={alternatePath}>{alternateLabel}</a>
    </header>
    <slot />
  </body>
</html>
