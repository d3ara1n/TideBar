"permission.openSettings" = "Open System Settings";
"permission.recheck" = "Check Again";
"permission.degradedNote" = "You can keep going without granting access: the tide line and app bar are unaffected — TideBar just can't list or restore windows. You can grant it later in Settings → Access.";

