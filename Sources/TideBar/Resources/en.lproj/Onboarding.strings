// 第 1 步：认识汐
"intro.title" = "Welcome to TideBar";
"intro.message" = "TideBar is a hairline tucked against the bottom edge of your screen — nearly invisible at rest. Move the cursor close and it rises into an app bar; press and hold any icon to reach every window of that app, minimized ones included.";
"intro.demoTitle" = "Demo: tide line → app bar → Surge";
"intro.demoCaption" = "Move close and the hairline rises into the app bar; press and hold (or ⌥-click) an icon and Surge lays out all of that app's windows";
"intro.privacyNote" = "TideBar shows no window content thumbnails and never requests screen recording.";

// 第 2 步：窗口管理权限
"permission.title" = "Window Management Access";
"permission.message" = "Accessibility access is used to list windows, identify minimized and fullscreen states, and bring the window you pick back to the front.";
