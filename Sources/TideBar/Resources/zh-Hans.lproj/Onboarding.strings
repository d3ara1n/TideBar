// 第 1 步：认识汐
"intro.title" = "欢迎使用汐 TideBar";
"intro.message" = "汐是一条收在屏幕底部的细线，空闲时几乎不可见。鼠标靠近时它潮汐般展开为应用栏；长按图标还能直达该应用的任意窗口——包括最小化的。";
"intro.demoTitle" = "演示：汐线 → 应用栏 → 潮涌";
"intro.demoCaption" = "鼠标靠近，细线展开为应用栏；长按（或 ⌥+点击）图标，潮涌列出该应用的全部窗口";
"intro.privacyNote" = "汐不提供窗口内容缩略图，也不会请求屏幕录制权限。";

// 第 2 步：窗口管理权限
"permission.title" = "窗口管理权限";
